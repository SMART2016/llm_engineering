      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "Tech Stack for CAG:\n\n• Knowledge Graphs: Neo4j, GraphDB, Amazon Neptune\n• Entity Extraction: spaCy, Hugging Face NER, OpenAI Functions\n• Graph Query: Cypher, SPARQL, Gremlin\n• Frameworks: LangGraph, LangChain with GraphRAG\n• Context Building: Subgraph extraction, path finding\n• Integration: Hybrid RAG+CAG for optimal context",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tech Stack for CAG:\n\n• Knowledge Graphs: Neo4j, GraphDB, Amazon Neptune\n• Entity Extraction: spaCy, Hugging Face NER, OpenAI Functions\n• Graph Query: Cypher, SPARQL, Gremlin\n• Frameworks: LangGraph, LangChain with GraphRAG\n• Context Building: Subgraph extraction, path finding\n• Integration: Hybrid RAG+CAG for optimal context",
      "lineHeight": 1.25,
      "baseline": 164
    }
