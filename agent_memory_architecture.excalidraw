    {
      "type": "text",
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "id": "rag-tech-stack",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 120,
      "y": 860,
      "strokeColor": "#495057",
      "backgroundColor": "#f8f9fa",
      "width": 460,
      "height": 170,
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "Tech Stack for RAG:\n\n• Embedding Models: OpenAI, Cohere, sentence-transformers\n• Vector Databases: Pinecone, Weaviate, Chroma, FAISS, Qdrant\n• Frameworks: LangChain, LlamaIndex, Haystack\n• Document Processing: Unstructured, PyPDF, BeautifulSoup\n• Chunking: Recursive splitting, semantic chunking\n• Retrieval: Cosine similarity, hybrid search (dense+sparse)",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tech Stack for RAG:\n\n• Embedding Models: OpenAI, Cohere, sentence-transformers\n• Vector Databases: Pinecone, Weaviate, Chroma, FAISS, Qdrant\n• Frameworks: LangChain, LlamaIndex, Haystack\n• Document Processing: Unstructured, PyPDF, BeautifulSoup\n• Chunking: Recursive splitting, semantic chunking\n• Retrieval: Cosine similarity, hybrid search (dense+sparse)",
      "lineHeight": 1.25,
      "baseline": 164
    },
